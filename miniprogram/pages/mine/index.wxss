.mine-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 60rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 30rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(124, 92, 255, 0.5), transparent 48%),
    linear-gradient(140deg, #1c2650, #2f46a8 65%, #5a3fd6);
  border-radius: 24rpx;
  color: #fff;
  box-shadow: 0 14rpx 40rpx rgba(47, 70, 168, 0.25);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 600;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-phone {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
}

.section {
  margin-top: 24rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 41, 55, 0.05);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.nickname-input {
  flex: 1;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e3e7ef;
  border-radius: 14rpx;
  background: #fbfcfe;
  font-size: 26rpx;
}

.save-btn {
  width: 140rpx;
  height: 78rpx;
  margin: 0;
  border-radius: 14rpx;
  background: #3b5bdb;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 41, 55, 0.05);
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
}

.menu-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8b93a3;
}

.menu-arrow {
  font-size: 38rpx;
  color: #9ca3af;
}

.dev-note {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #f1f3f8;
  color: #8b93a3;
  font-size: 22rpx;
  line-height: 1.6;
}
