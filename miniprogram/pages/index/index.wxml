<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view>
        <view class="eyebrow">EVENT SIGNUP</view>
        <view class="hero-title">活动报名</view>
      </view>
      <view class="mine-btn" bindtap="openMine">我的</view>
    </view>
    <view class="hero-desc">浏览活动、提交报名、查看电子票</view>
  </view>

  <scroll-view class="tabs" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view class="list">
    <view
      wx:for="{{activities}}"
      wx:key="id"
      class="activity-card"
      data-id="{{item.id}}"
      bindtap="openActivity"
    >
      <image
        wx:if="{{item.cover_url}}"
        class="cover"
        src="{{item.cover_url}}"
        mode="aspectFill"
      />
      <view wx:else class="cover cover-placeholder">
        <text class="cover-text">EVENT</text>
      </view>

      <view class="card-body">
        <view class="title-row">
          <text class="title">{{item.title}}</text>
          <text wx:if="{{item.need_review}}" class="tag tag-warn">需审核</text>
        </view>
        <view wx:if="{{item.summary}}" class="summary">{{item.summary}}</view>
        <view class="meta-row">
          <text class="meta">{{item.startText}}</text>
        </view>
        <view class="meta-row">
          <text class="meta">{{item.location_name}}</text>
          <text class="remaining">余 {{item.remaining}} / {{item.capacity}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="page-loading">加载中…</view>
    <view wx:elif="{{!activities.length}}" class="empty">
      <view>这个分类下还没有活动</view>
      <view class="empty-hint">下拉可以刷新</view>
    </view>
    <view wx:elif="{{!hasMore}}" class="list-end">已经到底了 · 共 {{total}} 场</view>
  </view>
</view>
