.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
  background:
    radial-gradient(circle at 85% 0%, rgba(124, 92, 255, 0.55), transparent 45%),
    linear-gradient(140deg, #1c2650, #2f46a8 60%, #5a3fd6);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.6);
}

.hero-title {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.mine-btn {
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.1);
}

.tabs {
  display: flex;
  white-space: nowrap;
  padding: 26rpx 24rpx 10rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #6b7280;
  font-size: 25rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 41, 55, 0.04);
}

.tab.active {
  background: #3b5bdb;
  color: #fff;
}

.list {
  padding: 16rpx 24rpx 0;
}

.activity-card {
  margin-bottom: 22rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 34rpx rgba(31, 41, 55, 0.07);
}

.cover {
  width: 100%;
  height: 260rpx;
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.12) 1rpx, transparent 1rpx),
    linear-gradient(140deg, #25305e, #4f6ef7 60%, #7c5cff);
  background-size: 44rpx 44rpx, 100% 100%;
}

.cover-text {
  font-size: 34rpx;
  letter-spacing: 8rpx;
  color: rgba(255, 255, 255, 0.72);
}

.card-body {
  padding: 24rpx 26rpx 26rpx;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
}

.summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.meta {
  font-size: 24rpx;
  color: #6b7280;
}

.remaining {
  font-size: 24rpx;
  color: #3b5bdb;
  font-weight: 500;
}

.list-end {
  padding: 28rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: #9ca3af;
}

.empty-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0b7c3;
}
