.detail-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.cover {
  width: 100%;
  height: 360rpx;
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.12) 1rpx, transparent 1rpx),
    linear-gradient(140deg, #25305e, #4f6ef7 60%, #7c5cff);
  background-size: 44rpx 44rpx, 100% 100%;
}

.cover-text {
  font-size: 38rpx;
  letter-spacing: 10rpx;
  color: rgba(255, 255, 255, 0.72);
}

.content {
  padding: 28rpx 28rpx 20rpx;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
}

.summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.65;
}

.info-card {
  margin-top: 24rpx;
  padding: 8rpx 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 41, 55, 0.05);
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 24rpx;
  color: #8b93a3;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 25rpx;
  line-height: 1.55;
}

.primary {
  color: #3b5bdb;
  font-weight: 600;
}

.section {
  margin-top: 28rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 41, 55, 0.05);
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.description {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
  white-space: pre-wrap;
}

.notice {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: #fff8ec;
  color: #b45309;
  font-size: 24rpx;
  line-height: 1.6;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #3b5bdb;
  font-size: 26rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 41, 55, 0.04);
}

.link-arrow {
  font-size: 34rpx;
  color: #9ca3af;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eef1f6;
  box-shadow: 0 -8rpx 30rpx rgba(31, 41, 55, 0.06);
}

.footer-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.footer-remaining {
  font-size: 26rpx;
  font-weight: 600;
}

.footer-reason {
  font-size: 22rpx;
  color: #9ca3af;
}

.footer-btn {
  width: 260rpx;
  height: 84rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #3b5bdb;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-btn.disabled {
  background: #b8c1e8;
}
