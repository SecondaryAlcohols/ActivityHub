.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  padding: 36rpx 32rpx 26rpx;
  background: linear-gradient(140deg, #1c2650, #2f46a8 65%, #5a3fd6);
  color: #fff;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.header-title {
  font-size: 42rpx;
  font-weight: 600;
}

.header-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
}

.tabs {
  display: flex;
  white-space: nowrap;
  padding: 24rpx 24rpx 8rpx;
}

.tab {
  display: inline-flex;
  padding: 10rpx 24rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #6b7280;
  font-size: 24rpx;
}

.tab.active {
  background: #3b5bdb;
  color: #fff;
}

.list {
  padding: 16rpx 24rpx 0;
}

.registration-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 41, 55, 0.06);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.divider {
  margin: 20rpx 0;
  height: 1rpx;
  background: #f0f2f6;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.applicant {
  font-size: 23rpx;
  color: #8b93a3;
}

.link {
  font-size: 24rpx;
  color: #3b5bdb;
}

.empty-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0b7c3;
}

.list-end {
  padding: 28rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: #9ca3af;
}
