ENVIRONMENT=development
DEBUG=true

# 本地默认使用 SQLite，无需安装数据库
# DATABASE_URL=sqlite+aiosqlite:///./event_system.db

# Docker / 生产环境使用 MySQL
# DATABASE_URL=mysql+aiomysql://event:eventpass@127.0.0.1:3306/event_system?charset=utf8mb4

# 生产环境（ENVIRONMENT=production）必须使用至少 32 位的随机字符串
JWT_SECRET=please-change-me-in-production-use-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 登录失败限流
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK_LOGIN=true
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_TIMEOUT_SECONDS=5
ATTENDEE_TOKEN_EXPIRE_DAYS=7

# 网页参与者体验登录（演示用，正式环境应替换为真实账号体系）
WEB_DEMO_LOGIN=true

# 电子票签名，必须与 JWT_SECRET 分开；生产环境至少 32 位
TICKET_SECRET=please-change-me-ticket-secret

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
